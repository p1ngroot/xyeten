[Unit]
Description=Raspberry Pi 4 Multitool - 5GHz WiFi Jammer
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/rpi-multitool
ExecStart=/usr/bin/python3 /opt/rpi-multitool/rpi_multitool.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
